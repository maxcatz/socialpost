{
  "name": "publish",
  "version": "1.0.0",
  "main": "publish.js",
  "type": "module",
  "scripts": {
    "start-js": "node --env-file=.env publishOld.js",
    "start-old": "node --env-file=.env -r ts-node publish.ts",
    "start-1": "node --env-file=.env --loader ts-node/esm ts-node src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "relay": "node --env-file=.env --import tsx src/relay.ts",
    "watch": "node --env-file=.env --import tsx src/relay.ts --watch",
    "drive-auth": "node --env-file=.env --import tsx src/driveAuth.ts",
    "accounts-push": "node --env-file=.env --import tsx src/accountsSync.ts push",
    "accounts-pull": "node --env-file=.env --import tsx src/accountsSync.ts pull",
    "telegram-login": "node --env-file=.env --import tsx src/telegramLogin.ts"
  },
  "volta": {
    "node": "24.17.0",
    "yarn": "4.17.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "clipboardy": "^5.3.1",
    "googleapis": "^173.0.0",
    "gray-matter": "^4.0.3",
    "open": "^11.0.0",
    "playwright-core": "^1.65.0",
    "qrcode-terminal": "^0.12.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/clipboardy": "^2.0.4",
    "@types/node": "^25.9.3",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "^0.28.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependenciesMeta": {
    "tsx@4.22.4": {
      "unplugged": true
    }
  }
}
